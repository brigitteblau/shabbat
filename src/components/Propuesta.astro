---
type Props = {
  id?: string;
};

const { id = "propuesta" } = Astro.props;
---

<section id={id} class="scroll-mt-24">
  <div
    class="rounded-[var(--sh-radius-blob)] border border-[color:var(--sh-border)] bg-[color:var(--sh-surface)] shadow-[var(--sh-shadow-soft)] backdrop-blur-sm"
  >
    <div class="p-6 sm:p-8">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 class="text-lg font-semibold tracking-tight text-[color:var(--sh-ink)]">
          Parashá de la semana
        </h2>
        <p
          id="propuestaParashaName"
          class="text-sm font-medium text-[color:var(--sh-soft)]"
        >
          Cargando…
        </p>
      </div>

      <p
        id="propuestaTeaching"
        class="mt-3 text-sm text-[color:var(--sh-muted)] sm:text-base"
      >
        Estamos trayendo la enseñanza de esta semana…
      </p>

      <div class="mt-4 rounded-2xl bg-white/60 p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-[color:var(--sh-soft)]">
          Para pensar
        </p>
        <p
          id="propuestaQuestion"
          class="mt-1 text-sm font-medium text-[color:var(--sh-ink)]"
        >
          —
        </p>
      </div>
    </div>
  </div>
</section>
